<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--=============== Medicine ====================-->


  <ThingDef ParentName="MedicineBase">
    <defName>MFFG_SimpleTentMaterial</defName>
    <label>simple tent material</label>
    <description>It is less potent than industrial pharmaceuticals, but much better than nothing.</description>
    <possessionCount>4</possessionCount>
    <graphicData>
      <texPath>Things/MFFG_SimpleTentMaterial</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <techLevel>Neolithic</techLevel>
    <statBases>
      <MarketValue>5</MarketValue>
      <Mass>0.2</Mass>
      <Flammability>1.3</Flammability>
      <MedicalPotency>0.40</MedicalPotency>
      <MedicalQualityMax>0.50</MedicalQualityMax>
      <DeteriorationRate>6</DeteriorationRate>
    </statBases>
    <tickerType>Rare</tickerType>
	<costStuffCount>5</costStuffCount>
	<stuffCategories>
      <li>Leathery</li>
    </stuffCategories>
    <recipeMaker>
      <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
      <workSkill>Intellectual</workSkill>
      <recipeUsers>
        <li>CraftingSpot</li>
      </recipeUsers>
	  <defaultIngredientFilter>
        <categories>
          <li>Root</li>
        </categories>
        <disallowedThingDefs>
          <li>Gold</li>
          <li>Silver</li>
          <li>Plasteel</li>
          <li>Jade</li>
          <li>Uranium</li>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Bioferrite</li>
        </disallowedThingDefs>
      </defaultIngredientFilter>
      <skillRequirements>
        <Crafting>1</Crafting>
        <Intellectual>1</Intellectual>
      </skillRequirements>
      <bulkRecipeCount>4</bulkRecipeCount>
      <displayPriority>2000</displayPriority>
    </recipeMaker>
  </ThingDef>

 
 
  <ThingDef ParentName="ApparelArmorHelmetReconBase">
    <defName>MFFG_Apparel_Medlink</defName>
    <label>medlink</label>
    <description>Augmented reality glasses contain a built-in AI surgeon that displays graphical instructions for treatment and surgery. The visor has a built-in scanner that detects damage in the patient's body.  It does not provide any protection when worn.\n\n Similar visors are used by doctors of utopian worlds.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Gunlink/Gunlink</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <equippedStatOffsets>
      <MedicalTendSpeed>0.5</MedicalTendSpeed>
	  <MedicalTendQuality>0.2</MedicalTendQuality>
	  <MedicalSurgerySuccessChance>0.1</MedicalSurgerySuccessChance>
    </equippedStatOffsets>
    <statBases>
      <ArmorRating_Sharp>0</ArmorRating_Sharp>
      <ArmorRating_Blunt>0</ArmorRating_Blunt>
      <ArmorRating_Heat>0</ArmorRating_Heat>
      <Insulation_Cold>0</Insulation_Cold>
      <Insulation_Heat>0</Insulation_Heat>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>Gunlink</researchPrerequisite>
      <displayPriority>400</displayPriority>
    </recipeMaker>
    <costList>
      <ComponentSpacer>1</ComponentSpacer>
      <Plasteel>10</Plasteel>
    </costList>
    <apparel>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Gunlink/Gunlink</wornGraphicPath>
      <renderSkipFlags>
        <li>None</li>
      </renderSkipFlags>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups Inherit="False">
        <li>UpperHead</li>
      </bodyPartGroups>
      <tags Inherit="False">
        <li>Medlink</li>
      </tags>
    </apparel>
    <tradeTags>
      <li>Clothing</li>
    </tradeTags>
    <thingSetMakerTags Inherit="False">
      <li>RewardStandardLowFreq</li>
    </thingSetMakerTags>
    <comps Inherit="False">
      <li Class="CompProperties_Biocodable"/>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable" />
      <li>
        <compClass>CompColorable</compClass>
      </li>
    </comps>
  </ThingDef>

