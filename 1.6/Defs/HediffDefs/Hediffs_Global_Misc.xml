<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  
  <HediffDef ParentName="DiseaseBase">
    <defName>MFFG_MedicalyInducedComa</defName>
    <label>medicaly induced coma</label>
    <description>Sleep drugs in the bloodstream. Anesthetic renders creatures unconscious.</description>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
		<comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.33</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
			<li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
    <stages>
      <li>
        <label>weakness</label>
        <painFactor>1.2</painFactor>
        <vomitMtbDays>0.25</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.7</setMax>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.5</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>Talking</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>Metabolism</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>Sight</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
        <forgetMemoryThoughtMtbDays>5</forgetMemoryThoughtMtbDays>
        <mentalStateGivers>
          <li>
            <mentalState>WanderConfused</mentalState>
            <mtbDays>5</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
      <li>
        <minSeverity>0.1</minSeverity>
        <label>sedated</label>
        <painFactor>0</painFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.01</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>