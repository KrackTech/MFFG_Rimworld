	<!--=============== Крафт синткани ====================-->
  <RecipeDef>
    <defName>MFFG_Make_Synthread</defName>
    <label>make synthread x10</label>
    <description>Make synthread x10.</description>
    <jobString>Making 10 synthread.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_Tailor</soundWorking>
    <workAmount>2400</workAmount>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Cloth</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>Wools</li>
          </categories>
        </filter>
        <count>5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Cloth</li>
        <li>WoolSheep</li>
        <li>WoolAlpaca</li>
        <li>WoolMegasloth</li>
        <li>WoolMuffalo</li>
        <li>WoolBison</li>
        <li>Chemfuel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Synthread>10</Synthread>
    </products>
		<researchPrerequisite>MedicineProduction</researchPrerequisite>
    <skillRequirements>
      <Crafting>2</Crafting>
			<Intellectual>6</Intellectual>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <displayPriority>11</displayPriority>
  </RecipeDef>

